                    <!-- Container principal -->
                    <table align="center" border="0" cellpadding="0" cellspacing="0" class="container" role="presentation" width="100%" style="max-width:600px; margin:0 auto;">
                        <!-- Header -->
                        <tr>
                            <td align="center" style="padding-bottom: 32px;">
                                <table border="0" cellpadding="0" cellspacing="0" role="presentation">
                                    <tr>
                                        <td style="vertical-align: middle;">
