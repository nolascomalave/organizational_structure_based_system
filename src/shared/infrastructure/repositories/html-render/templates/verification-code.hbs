                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>

                        <!-- Tarjeta principal -->
                        <tr>
                            <td style="background-color:#ffffff; border-radius:8px;">
                                <table border="0" cellpadding="0" cellspacing="0" role="presentation" width="100%" style="border:1px solid #e2e8f0;">
                                    <!-- Banda neutral superior -->
                                    <tr>
                                        <td align="center" style="background-color:#1e293b; padding:40px 24px;">
                                            <table border="0" cellpadding="0" cellspacing="0" role="presentation" style="display:inline-block;">
                                                <tr>
                                                    <td style="color: #FFF; padding: 16px; font-size: 18px; text-align:center; vertical-align:middle;">
                                                        <b>VERIFICATION CODE</b>
                                                    </td>
                                                </tr>
                                            </table>
                                        </td>
                                    </tr>

                                    <!-- Contenido -->
                                    <tr>
                                        <td class="content-padding" style="padding:40px;">
                                            <p style="margin:0 0 8px 0; font-family:'Inter',sans-serif; font-size:20px; font-weight:600; color:#0f172a;">Hello,</p>
                                            <p style="margin:0 0 32px 0; font-family:'Inter',sans-serif; font-size:16px; line-height:24px; color:#475569;">Use the following verification code to verify your {{sourceType}} ({{source}}) sign-in. This code is valid for {{expirationLongFormat}}.</p>

                                            <!-- Bloque del código -->
                                            <table border="0" cellpadding="0" cellspacing="0" role="presentation" width="100%" style="background-color:#f1f5f9; border:2px solid #e2e8f0; border-radius:12px; margin-bottom:24px;">
                                                <tr>
                                                    <td align="center" style="padding:32px 24px;">
                                                        <div class="code-text" style="font-family:'JetBrains Mono','Courier New',monospace; font-size:40px; font-weight:700; color:#1e293b; letter-spacing:0.2em; line-height:1;">{{verificationCode}}</div>

                                                        <!-- Temporizador -->
                                                        <table align="center" border="0" cellpadding="0" cellspacing="0" role="presentation" style="margin-top:16px;">
                                                            <tr>
                                                                <td style="vertical-align:middle;">
                                                                    <span style="font-family:'Inter',sans-serif; font-size:12px; font-weight:500; color:#64748b; text-transform:uppercase; letter-spacing:0.05em;">Expires in {{digitalFormatExpiration}}</span>
                                                                </td>
                                                            </tr>
                                                        </table>
                                                    </td>
                                                </tr>
                                            </table>

                                            <!-- Nota de seguridad -->
                                            <table border="0" cellpadding="0" cellspacing="0" role="presentation" width="100%" style="background-color:#f8fafc; border-left:4px solid #94a3b8; border-radius:2px; margin-bottom:32px;">
                                                <tr>
                                                    <td style="padding:16px;">
                                                        <table border="0" cellpadding="0" cellspacing="0" role="presentation">
                                                            <tr>
                                                                <td>
                                                                    <p style="margin:0; font-family:'Inter',sans-serif; font-size:14px; line-height:20px; color:#64748b;">If you didn't request this code, you can safely ignore this email. Someone else might have entered your email address by mistake.</p>
                                                                </td>
                                                            </tr>
                                                        </table>
                                                    </td>
                                                </tr>
                                            </table>

                                            <!-- Botón Opcional (Se mantiene comentado pero con colores neutrales) -->
                                            <!-- <table border="0" cellpadding="0" cellspacing="0" role="presentation" width="100%">
                                                <tr>
                                                    <td align="center">
