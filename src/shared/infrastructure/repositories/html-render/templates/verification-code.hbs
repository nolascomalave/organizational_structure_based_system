<body style="background-color: #f8fafc; margin:0; padding:0;">

    <!-- Email wrapper -->
    <div aria-roledescription="email" role="article" lang="en" style="background-color:#f8fafc; width:100%;">
        <table align="center" border="0" cellpadding="0" cellspacing="0" role="presentation" width="100%" style="background-color:#f8fafc;">
            <tr>
                <td align="center" style="padding: 32px 16px;">

