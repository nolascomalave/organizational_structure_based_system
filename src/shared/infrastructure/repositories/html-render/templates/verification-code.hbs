                                                                    <a href="#" style="display:block; background-color:#1e293b; color:#ffffff; text-decoration:none; font-family:'Inter',sans-serif; font-size:16px; font-weight:600; text-align:center;">Verify My Identity</a>
                                                                </td>
                                                            </tr>
                                                        </table>
                                                    </td>
                                                </tr>
                                            </table> -->
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>

                        <!-- Insignia de transmisión auténtica -->
                        <tr>
                            <td align="center" style="padding-top:32px;">
                                <table border="0" cellpadding="0" cellspacing="0" role="presentation" style="background-color:#f1f5f9; border-radius:9999px; display:inline-block;">
                                    <tr>
                                        <td style="padding:8px 16px;">
                                            <table border="0" cellpadding="0" cellspacing="0" role="presentation">
                                                <tr>
                                                    <td style="vertical-align:middle;">
                                                        <span style="font-family:'Inter',sans-serif; font-size:12px; font-weight:500; color:#475569; text-transform:uppercase; letter-spacing:0.05em;">Authentic SecureAuth Transmission</span>
                                                    </td>
                                                </tr>
                                            </table>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>

